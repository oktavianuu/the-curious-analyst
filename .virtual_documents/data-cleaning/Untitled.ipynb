library(nnet)       # For multinom()
library(ggplot2)    # For visualization
library(dplyr)      # For data manipulation
library(ggeffects)  # For calculating predicted probabilities
library(readxl)


df <- read.csv("ana.csv")
head(df)


# Recoding all three variables
df_clean <- df %>%
  mutate(across(c(citra_tubuh, aktivitas_fisik, gizi_seimbang), 
         ~ case_when(
           . %in% c(1, 2) ~ "Rendah",
           . == 3        ~ "Sedang",
           . %in% c(4, 5) ~ "Tinggi"
         ))) %>%
  # Convert to factors and set logical order
  mutate(across(everything(), 
         ~ factor(., levels = c("Rendah", "Sedang", "Tinggi"))))

# Set the reference (baseline) for the outcome and predictors
# We usually compare everything against the 'Low' or 'Healthy/High' group.
# Let's use 'Low' as the baseline for Citra Tubuh.
df_clean$citra_tubuh <- relevel(df_clean$citra_tubuh, ref = "Rendah")


head(df_clean)


# 3. Fit the Model
model <- multinom(citra_tubuh ~ aktivitas_fisik + gizi_seimbang, data = df_clean)


# 4. Model Summary & Exponentiating coefficients for Odds Ratios
summary(model)



exp(coef(model))


# 5. Predict Probabilities for Visualization
predicted_probs <- ggpredict(model, terms = c("aktivitas_fisik", "gizi_seimbang"))
plot(predicted_probs)


library(sjPlot)


# This creates a publication-quality table
tab_model(model, 
          show.re.var = FALSE, 
          show.stat = TRUE,    # Shows the Z-statistic
          show.se = TRUE,      # Shows Standard Errors
          string.est = "Logits (Beta)",
          string.stat = "z-score",
          transform = NULL,    # First, let's look at Logits
          title = "Table 1: Multinomial Logistic Regression (Logits)")

# Now, create one specifically for Odds Ratios (most important for the paper)
tab_model(model, 
          show.se = TRUE, 
          show.p = TRUE, 
          transform = "exp",   # This exponentiates the Logits into Odds Ratios
          string.est = "Odds Ratio (OR)",
          title = "Table 2: Multinomial Logistic Regression (Odds Ratios)")


# Option 1: Save to an HTML file (Recommended)
# This creates a file in your current folder that you can open with Chrome/Edge/Safari
tab_model(model, 
          transform = "exp", 
          string.est = "Odds Ratio (OR)",
          file = "result_table.html") # <--- This line fixes the error

# Option 2: Show it in the RStudio 'Viewer' pane 
# (Only works if you are using RStudio)
plot_model(model, type = "int") # This is for plots, but for tables use:
# sjPlot::view_df(df_clean)


library(broom)


# 1. Get the basic tidy output (Logits, SE, p-values)
tidy_table <- tidy(model, conf.int = TRUE)

# 2. Add Odds Ratios and their Confidence Intervals
# Math: OR = exp(estimate)
tidy_table <- tidy_table %>%
  mutate(
    odds_ratio = exp(estimate),
    OR_conf_low = exp(conf.low),
    OR_conf_high = exp(conf.high)
  ) %>%
  select(y.level, term, estimate, std.error, p.value, odds_ratio, OR_conf_low, OR_conf_high)

# View the result
print(tidy_table)


View(tidy_table)


print.data.frame(tidy_table)


# Plotting the Odds Ratios
plot_model(model, 
           type = "est", 
           transform = "exp", 
           show.values = TRUE, 
           value.offset = .3,
           title = "Strength of Association (Odds Ratios)") +
  theme_minimal()


# Calculate predicted probabilities for Nutrition
mydf <- predict_response(model, terms = "gizi_seimbang")

# Plotting
ggplot(mydf, aes(x = x, y = predicted, fill = response)) +
  geom_bar(stat = "identity", position = "fill") +
  scale_fill_manual(values = c("#e74c3c", "#f1c40f", "#2ecc71")) + # Red, Yellow, Green
  labs(title = "Probabilities of Body Image Levels by Nutrition",
       x = "Balanced Nutrition Level",
       y = "Probability (0.0 - 1.0)",
       fill = "Body Image") +
  theme_minimal()


# Probability based on BOTH variables
mydf_both <- predict_response(model, terms = c("gizi_seimbang", "aktivitas_fisik"))

plot(mydf_both) + 
  labs(title = "The Interaction of Nutrition and Activity on Body Image")


# This usually works perfectly in Jupyter Lab
plot(mydf) + 
  scale_fill_manual(values = c("#e74c3c", "#f1c40f", "#2ecc71")) +
  theme_minimal()


# Look at the first few rows to see the column names
head(as.data.frame(mydf))


library(ggplot2)

# Convert to a standard data frame first to be safe
plot_data <- as.data.frame(mydf)

ggplot(plot_data, aes(x = x, y = predicted, fill = group)) + # Change 'response' to 'group'
  geom_bar(stat = "identity", position = "fill") +
  scale_fill_manual(values = c("#e74c3c", "#f1c40f", "#2ecc71")) +
  labs(title = "Probabilities of Body Image Levels by Nutrition",
       x = "Balanced Nutrition Level",
       y = "Probability (0.0 - 1.0)",
       fill = "Body Image") +
  theme_minimal()



